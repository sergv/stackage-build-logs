    instance RouteAttrs MyApp where
      routeAttrs (ParentR _ ChildR {}) = Set.fromList [pack "child"]
      routeAttrs RootR {} = Set.fromList [pack "foo", pack "bar"]
      routeAttrs BlogPostR {} = Set.fromList []
      routeAttrs WikiR {} = Set.fromList []
      routeAttrs SubsiteR {} = Set.fromList []
      routeAttrs SubparamR {} = Set.fromList []
    instance RenderRoute MyApp where
      data YRC.Route MyApp
        = ParentR Text ParentR |
          RootR |
          BlogPostR Text |
          WikiR [Text] |
          SubsiteR (YRC.Route MySub) |
          SubparamR Int (YRC.Route MySubParam)
        deriving (Eq, Show, Read)
      renderRoute (ParentR dyn_av8j child_av8k)
        = (\ (a_av8m, b_av8n)
             -> ((pack "foo" : (Web.PathPieces.toPathPiece dyn_av8j : a_av8m)), 
                 b_av8n))
            (childRender_av8l child_av8k)
        where
            childRender_av8l ChildR = ([], [])
      renderRoute RootR = ([], [])
      renderRoute (BlogPostR dyn_av8o)
        = ((pack "blog" : (Web.PathPieces.toPathPiece dyn_av8o : [])), [])
      renderRoute (WikiR dyn_av8p)
        = ((pack "wiki" : Web.PathPieces.toPathMultiPiece dyn_av8p), [])
      renderRoute (SubsiteR sub_av8q)
        = (\ (a_av8r, b_av8s) -> ((pack "subsite" : a_av8r), b_av8s))
            (renderRoute sub_av8q)
      renderRoute (SubparamR dyn_av8t sub_av8u)
        = (\ (a_av8v, b_av8w)
             -> ((pack "subparam"
                    : (Web.PathPieces.toPathPiece dyn_av8t : a_av8v)), 
                 b_av8w))
            (renderRoute sub_av8u)
    data ParentR
      = ChildR
      deriving (Eq, Show, Read)
